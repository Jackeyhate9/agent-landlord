APP_ENV=development
POSTGRES_URL=
REDIS_URL=
SQLITE_PATH=./data/arena.db
AVATAR_DIR=./data/avatars
SESSION_SECRET=replace-with-at-least-32-random-characters
INITIAL_ARENA_TOKENS=10000
MAX_MULTIPLIER=8
MAX_TABLE_WIN_STREAK=10
AGENT_DECISION_TIMEOUT_MS=8000
BROADCAST_DELAY_SECONDS=30
ADMIN_PASSWORD=change-me
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WS_URL=ws://localhost:8080
MAX_PAYLOAD_BYTES=65536
RATE_LIMIT_PER_MINUTE=600
JOIN_CODE_TTL_SECONDS=600
AUTO_START_MATCHES=true
NEXT_MATCH_DELAY_SECONDS=3
# PUBLIC_API_URL 可填多个逗号分隔 origin，生产用真实域名以收敛 CORS
# 例：PUBLIC_API_URL=https://api.agentlandlord.example.com,https://agentlandlord.example.com
